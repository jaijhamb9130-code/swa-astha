# Swa-Astha Backend — environment template
# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=development

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/swaastha

# ── Auth ──
# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── SMS (Twilio) — used only when NODE_ENV=production ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── CORS ── comma-separated list of allowed origins (no trailing slash)
FRONTEND_URL=http://localhost:3000,http://localhost:5000

# ── Uploads ──
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads

# ── AI prescription scanning (optional; leave empty to disable) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# ── Admin panel ── REQUIRED for /admin and /api/admin/* routes
# Sent via X-Admin-Secret header only (never query string).
ADMIN_SECRET=

# ── OTP rate limiter (token bucket per phone/IP) ──
OTP_RATE_MAX=3
OTP_RATE_WINDOW_SEC=60

# ── Idempotency cache TTL for checkout ──
IDEMPOTENCY_TTL_SEC=30

# ── Razorpay (optional) ──
RAZORPAY_KEY=
RAZORPAY_SECRET=
